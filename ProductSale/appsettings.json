{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/myapp_log-.txt",
          "rollingInterval": "Day", // Creates files named myapp_log-YYYYMMDD.txt
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level}] {Message}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "FileExtensions": {
    ".pdf": ".pdf",
    ".jpg": ".jpg",
    ".jpeg": ".jpeg",
    ".png": ".png",
    ".bmp": ".bmp"
  },
  "Template": {
    "UserEmail": {
      "Signup": {
        "Subject": "Welcome To jiyazon.com !!!!",
        "TemplateFile": "Signup.cshtml"
      },
      "ForgotPassword": {
        "Subject": "Generate new password",
        "TemplateFile": "ResetPassword.cshtml"
      },
      "Order": {
        "Subject": "Your Order Placed with Order Id : {1}",
        "TemplateFile": "Order.cshtml"
      }
    },
    "AdminEmail": {
      "Order": {
        "Subject": "Order Placed By User : {0} - OrderId : {1}",
        "TemplateFile": "Order.cshtml"
      }
    }
  }
}
