@{
    Layout = "/EmailTemplate/_EmaliLayout.cshtml";
}
<p style="line-height: 15.0pt; padding: 8px 0px; margin: 0px;">
    <span style="font-size: 10.5pt;">
        <b>Dear User,</b>
    </span>
</p>
<p style="line-height: 15.0pt; padding: 8px 0px; margin: 0px;">

    <span style="font-size: 10.5pt;">
        Below are the new products introduce.
    </span>
</p>
<p style="line-height: 15.0pt; padding: 8px 0px; margin: 0px;">
    @if (Model.Products != null && Model.Products.Count > 0)
    {
        <table style="width:100%; border-collapse: collapse; border: 1px solid #cccccc;">
            <thead>
                <tr>
                    <td style="border: 1px solid #cccccc; padding: 8px; text-align: left;">Product Name</td>
                    <td style="border: 1px solid #cccccc; padding: 8px; text-align: left;">Price(£)</td>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Products)
                {
                    <tr>
                        <td style="border: 1px solid #cccccc; padding: 8px;">@item.Name</td>
                        <td style="border: 1px solid #cccccc; padding: 8px;">@item.Price.ToString("C", new System.Globalization.CultureInfo("en-GB"))</td>
                    </tr>
                }
            </tbody>
        </table>
    }

</p>
<p style="line-height: 15.0pt; padding: 8px 0px; margin: 0px;">
    <span style="font-size: 10.5pt;">
        Best regards,
    </span>
</p>
<p>
    <span>
        Sincerely,<br />
        jiyazon.com
    </span>
</p>