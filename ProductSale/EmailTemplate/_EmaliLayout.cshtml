@using FluentEmail.Razor
<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <title></title>
</head>
<body style="font-family:Arial,sans-serif;background-color:#f4f4f4; margin:0; margin:0;">
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" style="width:100%; max-width:600px; margin: 0 auto; background: #ffffff;">
        <tr>
            <td style="background-color:#007bff; color: #ffffff; padding:20px; text-align:center;display:flex;gap:80px;">
                <img src="http://jiyazon.com/api/images/bg100x100.png" />
                <h1>jiyazon.com</h1>
            </td>
        </tr>
        <tr>
            <td style="padding: 30px; line-height: 1.6; color: #333333;">
                @RenderBody()
            </td>
        </tr>
        <tr>
            <td>
                <p style="line-height: 15.0pt; padding: 8px 0px; margin: 0px;">
                    <span style="font-size: 5.5pt;">
                        Follow the Jiyazon.com channel on WhatsApp: https://whatsapp.com/channel/0029VbBNvDrGE56ebSHoyE24
                    </span>
                </p>
            </td>
        </tr>
        <tr>
            <td style="background-color:#eeeeee; padding:15px; text-align: center; font-size: 12px; color: #777777;">
                <p style="line-height: 15.0pt; padding: 8px 0px; margin: 0px;">&copy; @DateTime.Now.Year - jiyazon.com. All rights reserved.</p>
            </td>
        </tr>
    </table>
</body>
</html>
